From 892a20e7171f9db9ab217ca4f20ebc4fdf3f8fcc Mon Sep 17 00:00:00 2001
From: Santiago Postacchini <postacchinisantiago@gmail.com>
Date: Thu, 8 Oct 2026 23:16:26 -0300
Subject: [PATCH 11/11] cgame: sangre y mancha de dano sin dlc_gibs

bloodSpray1-4 y viewBloodBlend usan dlc_gibs/*.tga, que no esta en el pak00.pk3 de Steam ni se publica
(pak01 va solo con textos): se dibujaban como la caja gris por defecto. Shaders nuevos qwBloodSpray1-4 y
qwViewBlood con gfx/damage/{ice_spurt,ice_stain,damage_screen}, tenidos de rojo.
---
 code/cgame/cg_main.c                  | 10 ++--
 content/pak01/scripts/quakeweb.shader | 74 +++++++++++++++++++++++++++
 2 files changed, 79 insertions(+), 5 deletions(-)
 create mode 100644 content/pak01/scripts/quakeweb.shader

diff --git a/code/cgame/cg_main.c b/code/cgame/cg_main.c
index b7ea93e9..f222d0a0 100644
--- a/code/cgame/cg_main.c
+++ b/code/cgame/cg_main.c
@@ -1689,7 +1689,7 @@ static void CG_RegisterGraphics(void) {
     cgs.media.botSkillShaders[3] = trap_R_RegisterShader("menu/art/skill4.png");
     cgs.media.botSkillShaders[4] = trap_R_RegisterShader("menu/art/skill5.png");
 
-    cgs.media.viewBloodShader = trap_R_RegisterShader("viewBloodBlend");
+    cgs.media.viewBloodShader = trap_R_RegisterShader("qwViewBlood");
 
     cgs.media.deferShader = trap_R_RegisterShaderNoMip("gfx/2d/defer.png");
 
@@ -1707,10 +1707,10 @@ static void CG_RegisterGraphics(void) {
 
     cgs.media.plasmaBallShader = trap_R_RegisterShader("sprites/plasma1");
     // [QL] blood spray shaders (translucent sprites with proper alpha blend)
-    cgs.media.bloodSprayShaders[0] = trap_R_RegisterShader("bloodSpray1");
-    cgs.media.bloodSprayShaders[1] = trap_R_RegisterShader("bloodSpray2");
-    cgs.media.bloodSprayShaders[2] = trap_R_RegisterShader("bloodSpray3");
-    cgs.media.bloodSprayShaders[3] = trap_R_RegisterShader("bloodSpray4");
+    cgs.media.bloodSprayShaders[0] = trap_R_RegisterShader("qwBloodSpray1");
+    cgs.media.bloodSprayShaders[1] = trap_R_RegisterShader("qwBloodSpray2");
+    cgs.media.bloodSprayShaders[2] = trap_R_RegisterShader("qwBloodSpray3");
+    cgs.media.bloodSprayShaders[3] = trap_R_RegisterShader("qwBloodSpray4");
     cgs.media.bloodTrailShader = cgs.media.bloodSprayShaders[0];
     cgs.media.lagometerShader = trap_R_RegisterShader("lagometer");
     cgs.media.connectionShader = trap_R_RegisterShader("disconnected");
diff --git a/content/pak01/scripts/quakeweb.shader b/content/pak01/scripts/quakeweb.shader
new file mode 100644
index 00000000..47ea2230
--- /dev/null
+++ b/content/pak01/scripts/quakeweb.shader
@@ -0,0 +1,74 @@
+// QuakeWeb: sangre y mancha de daño con texturas que están en el pak00.pk3 de Quake Live.
+// Los shaders originales (bloodSpray1-4, viewBloodBlend) usan dlc_gibs/*.tga, que no está en el pak00.pk3
+// de Steam ni se publica (pak01 va sólo con textos), y se dibujaban como la caja gris por defecto.
+// Acá se reusan las salpicaduras de hielo y la mancha de daño de gfx/damage, teñidas de rojo sangre.
+
+// Mancha roja que se superpone en pantalla al recibir daño
+qwViewBlood
+{
+	nopicmip
+	sort	nearest
+	{
+		map gfx/damage/damage_screen.tga
+		blendfunc blend
+		rgbGen const ( 0.8 0.0 0.0 )
+		alphaGen vertex
+	}
+}
+
+// Sangre al impactar a un jugador (partículas, gotas y marcas en el piso/paredes)
+qwBloodSpray1
+{
+	polygonOffset
+	sort 6
+	nopicmip
+	entityMergable
+	{
+		clampmap gfx/damage/ice_spurt.tga
+		blendfunc blend
+		rgbGen const ( 0.65 0.02 0.02 )
+		alphaGen vertex
+	}
+}
+
+qwBloodSpray2
+{
+	polygonOffset
+	sort 6
+	nopicmip
+	entityMergable
+	{
+		clampmap gfx/damage/ice_stain.tga
+		blendfunc blend
+		rgbGen const ( 0.55 0.0 0.0 )
+		alphaGen vertex
+	}
+}
+
+qwBloodSpray3
+{
+	polygonOffset
+	sort 6
+	nopicmip
+	entityMergable
+	{
+		clampmap gfx/damage/ice_spurt.tga
+		blendfunc blend
+		rgbGen const ( 0.5 0.0 0.0 )
+		alphaGen vertex
+	}
+}
+
+qwBloodSpray4
+{
+	polygonOffset
+	sort 6
+	nopicmip
+	entityMergable
+	{
+		clampmap gfx/damage/ice_stain.tga
+		blendfunc blend
+		rgbGen const ( 0.7 0.03 0.03 )
+		alphaGen vertex
+	}
+}
-- 
