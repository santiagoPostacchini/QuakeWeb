From 0c219401e5ba2d418ae0e7568f13728c8c0891cc Mon Sep 17 00:00:00 2001
From: Santiago Postacchini <postacchinisantiago@gmail.com>
Date: Wed, 7 Oct 2026 19:17:15 -0300
Subject: [PATCH] Web: atlas de fuentes RGBA (WebGL 2 no tiene texture swizzle)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 code/renderergl2/tr_font_gl.c | 43 ++++++++++++++++++++++++++++++++---
 1 file changed, 40 insertions(+), 3 deletions(-)

diff --git a/code/renderergl2/tr_font_gl.c b/code/renderergl2/tr_font_gl.c
index 8aa8fa6..8ebc2e0 100644
--- a/code/renderergl2/tr_font_gl.c
+++ b/code/renderergl2/tr_font_gl.c
@@ -75,11 +75,24 @@ static unsigned int R_Font_PackColor(const vec4_t c) {
 // shader (texture * vertexColor) gives antialiased coloured text.  DSA (by
 // texture name), so it works at init time; GL_BindToTMU is a per-frame backend
 // helper and must not be used here.
+// QuakeWeb: WebGL 2 no tiene GL_TEXTURE_SWIZZLE; un atlas GL_R8 se lee (R,0,0,1) y cada letra queda en una caja
+// opaca. En la web el atlas es RGBA8 y cada subida se expande a (255,255,255,cobertura), que es lo mismo que daba
+// el swizzle (1,1,1,R) en escritorio.
+#ifdef __EMSCRIPTEN__
+#define FONT_ATLAS_INTERNAL GL_RGBA8
+#define FONT_ATLAS_FORMAT   GL_RGBA
+#else
+#define FONT_ATLAS_INTERNAL GL_R8
+#define FONT_ATLAS_FORMAT   GL_RED
+#endif
+
 static void R_Font_SetTexParams(GLuint tex) {
+#ifndef __EMSCRIPTEN__
     qglTextureParameteriEXT(tex, GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_R, GL_ONE);
     qglTextureParameteriEXT(tex, GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_G, GL_ONE);
     qglTextureParameteriEXT(tex, GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_B, GL_ONE);
     qglTextureParameteriEXT(tex, GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_A, GL_RED);
+#endif
     qglTextureParameteriEXT(tex, GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
     qglTextureParameteriEXT(tex, GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
 }
@@ -106,9 +119,9 @@ static int RB_Font_renderCreate(void *uptr, int width, int height) {
         return 0;
 
     // Redefine as single-channel GL_R8 with a coverage swizzle (DSA - no bind).
-    qglTextureImage2DEXT(fontImage->texnum, GL_TEXTURE_2D, 0, GL_R8, width, height, 0, GL_RED, GL_UNSIGNED_BYTE, NULL);
+    qglTextureImage2DEXT(fontImage->texnum, GL_TEXTURE_2D, 0, FONT_ATLAS_INTERNAL, width, height, 0, FONT_ATLAS_FORMAT, GL_UNSIGNED_BYTE, NULL);
     R_Font_SetTexParams(fontImage->texnum);
-    fontImage->internalFormat = GL_R8;
+    fontImage->internalFormat = FONT_ATLAS_INTERNAL;
     fontImage->width = fontImage->uploadWidth = width;
     fontImage->height = fontImage->uploadHeight = height;
 
@@ -127,7 +140,7 @@ static int RB_Font_renderResize(void *uptr, int width, int height) {
 
     // Reuse the same texture object / image_t / shader, redefine storage only.
     // fontstash re-marks all existing glyphs dirty, so content is re-uploaded.
-    qglTextureImage2DEXT(fontImage->texnum, GL_TEXTURE_2D, 0, GL_R8, width, height, 0, GL_RED, GL_UNSIGNED_BYTE, NULL);
+    qglTextureImage2DEXT(fontImage->texnum, GL_TEXTURE_2D, 0, FONT_ATLAS_INTERNAL, width, height, 0, FONT_ATLAS_FORMAT, GL_UNSIGNED_BYTE, NULL);
     R_Font_SetTexParams(fontImage->texnum);
     fontImage->width = fontImage->uploadWidth = width;
     fontImage->height = fontImage->uploadHeight = height;
@@ -148,6 +161,30 @@ static void RB_Font_renderUpdate(void *uptr, int *rect, const unsigned char *dat
     if (fontImage == NULL || w <= 0 || h <= 0)
         return;
 
+#ifdef __EMSCRIPTEN__
+    {
+        // `data` es el atlas entero (un byte por píxel); se expande el rectángulo sucio a blanco + cobertura
+        byte *rgba = (byte *)malloc((size_t)w * h * 4);
+        int x, y;
+        if (rgba == NULL)
+            return;
+        for (y = 0; y < h; y++) {
+            const unsigned char *fila = data + (size_t)(rect[1] + y) * fontAtlasWidth + rect[0];
+            byte *dst = rgba + (size_t)y * w * 4;
+            for (x = 0; x < w; x++, dst += 4) {
+                dst[0] = dst[1] = dst[2] = 255;
+                dst[3] = fila[x];
+            }
+        }
+        qglPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+        qglTextureSubImage2DEXT(fontImage->texnum, GL_TEXTURE_2D, 0, rect[0], rect[1], w, h, GL_RGBA, GL_UNSIGNED_BYTE, rgba);
+        qglPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+        free(rgba);
+        GL_CheckErrors();
+        return;
+    }
+#endif
+
     // Upload the dirty sub-rect (DSA - no bind).  Pixel-unpack state is global
     // and applies to DSA texture uploads.
     qglPixelStorei(GL_UNPACK_ALIGNMENT, 1);
-- 
2.45.1.windows.1

