From c84b0dfb6d5a58d96a46155c89cc5e367f17d102 Mon Sep 17 00:00:00 2001
From: Santiago Postacchini <postacchinisantiago@gmail.com>
Date: Wed, 7 Oct 2026 16:16:40 -0300
Subject: [PATCH 4/5] Emscripten: conservar nombres de funciones para
 diagnosticar

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Makefile | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index d8715bc..37316c6 100644
--- a/Makefile
+++ b/Makefile
@@ -1002,6 +1002,8 @@ ifeq ($(PLATFORM),emscripten)
   CLIENT_LDFLAGS+=-s EXIT_RUNTIME=1
   # QuakeWeb: el motor carga la lógica de juego (cgame, qagame, ui) con dlopen, como módulos wasm.
   CLIENT_LDFLAGS+=-s MAIN_MODULE=1
+  # Nombres de funciones en el wasm: las pilas de error dicen qué función falló (lección 9 de CSweb).
+  CLIENT_LDFLAGS+=--profiling-funcs
   # Con MAIN_MODULE todo el código del motor tiene que ser PIC (si no, wasm-ld: "recompile with -fPIC").
   BASE_CFLAGS+=-fPIC
   CLIENT_LDFLAGS+=-s EXPORT_ES6
@@ -1036,7 +1038,7 @@ ifeq ($(PLATFORM),emscripten)
   # QuakeWeb: SIDE_MODULE=2 descarta lo que no se exporta; el motor sólo busca dllEntry y vmMain.
   # Con SIDE_MODULE=1 cgame pesaba 14 MB, más que el tope de Chrome para compilar wasm en el hilo principal.
   # qagame sólo exporta dllEntry (estilo QL: devuelve vmMain por puntero); cgame y ui exportan los dos.
-  SHLIBLDFLAGS=-s SIDE_MODULE=2 -s EXPORTED_FUNCTIONS=_dllEntry,_vmMain -Wno-undefined
+  SHLIBLDFLAGS=-s SIDE_MODULE=2 -s EXPORTED_FUNCTIONS=_dllEntry,_vmMain -Wno-undefined --profiling-funcs
 
 else # ifeq emscripten
 
-- 
