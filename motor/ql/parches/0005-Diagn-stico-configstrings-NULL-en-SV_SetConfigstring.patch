Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 code/server/sv_init.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/code/server/sv_init.c b/code/server/sv_init.c
index 153697d..ff6fbdd 100644
--- a/code/server/sv_init.c
+++ b/code/server/sv_init.c
@@ -120,7 +120,13 @@ void SV_SetConfigstring(int index, const char* val) {
     }
 
     // change the string in sv
-    Z_Free(sv.configstrings[index]);
+    // QuakeWeb: diagnóstico del port web; en wasm leer NULL no rompe (en nativo strcmp(NULL) ya habría fallado)
+    if (!sv.configstrings[index]) {
+        Com_Printf("^1QuakeWeb: SV_SetConfigstring(%i) con configstring NULL (sv=%p)
+", index, (void*)&sv);
+    } else {
+        Z_Free(sv.configstrings[index]);
+    }
     sv.configstrings[index] = CopyString(val);
 
     // send it to all the clients if we aren't
@@ -610,6 +616,8 @@ void SV_SpawnServer(char* server, qboolean killBots) {
     for (i = 0; i < MAX_CONFIGSTRINGS; i++) {
         sv.configstrings[i] = CopyString("");
     }
+    Com_Printf("QuakeWeb: configstrings inicializadas (sv=%p, cs[12]=%p)
+", (void*)&sv, (void*)sv.configstrings[12]);
 
     // make sure we are not paused
     Cvar_Set("cl_paused", "0");
