diff --git a/code/qcommon/cm_load.c b/code/qcommon/cm_load.c
index 1aa0fbe..e3df4ee 100644
--- a/code/qcommon/cm_load.c
+++ b/code/qcommon/cm_load.c
@@ -626,7 +626,7 @@ void CM_LoadMap( const char *name, qboolean clientload, int *checksum ) {
 		((int *)&header)[i] = LittleLong ( ((int *)&header)[i]);
 	}
 
-	if ( header.version != BSP_VERSION ) {
+	if ( !BSP_VERSION_OK( header.version ) ) {
 		Com_Error (ERR_DROP, "CM_LoadMap: %s has wrong version number (%i should be %i)"
 		, name, header.version, BSP_VERSION );
 	}
diff --git a/code/qcommon/qfiles.h b/code/qcommon/qfiles.h
index 9f2b5fb..a844c49 100644
--- a/code/qcommon/qfiles.h
+++ b/code/qcommon/qfiles.h
@@ -315,6 +315,12 @@ typedef struct {
 
 #define BSP_VERSION			46
 
+// QuakeWeb: los mapas de Quake Live son la versión 47. Tienen las mismas 17 secciones que la 46
+// más una 18ª (carteles de publicidad, 128 bytes cada uno) que acá se ignora: como dheader_t sólo
+// declara 17, esa sección queda fuera de la cabecera leída.
+#define BSP_VERSION_QL		47
+#define BSP_VERSION_OK(v)	((v) == BSP_VERSION || (v) == BSP_VERSION_QL)
+
 
 // there shouldn't be any problem with increasing these values at the
 // expense of more memory allocation in the utilities
diff --git a/code/renderergl1/tr_bsp.c b/code/renderergl1/tr_bsp.c
index 5de7ff9..763b6ca 100644
--- a/code/renderergl1/tr_bsp.c
+++ b/code/renderergl1/tr_bsp.c
@@ -1837,7 +1837,7 @@ void RE_LoadWorldMap( const char *name ) {
 	fileBase = (byte *)header;
 
 	i = LittleLong (header->version);
-	if ( i != BSP_VERSION ) {
+	if ( !BSP_VERSION_OK( i ) ) {
 		ri.Error (ERR_DROP, "RE_LoadWorldMap: %s has wrong version number (%i should be %i)", 
 			name, i, BSP_VERSION);
 	}
